---
import { getCollection } from 'astro:content';
import { getClusterForHub } from '@data/content-clusters';

interface Props {
  /** Slug des Leistungs-Hubs, z. B. "webdesign" */
  hub: string;
  title?: string;
  intro?: string;
}

const { hub, title = 'Zum Weiterlesen', intro } = Astro.props;

const cluster = getClusterForHub(hub);

const blogEntries = cluster?.blog.length
  ? (await getCollection('blog', ({ data }) => data.draft !== true)).filter((e) =>
      cluster.blog.includes(e.id)
    )
  : [];

const wissenEntries = cluster?.wissen.length
  ? (await getCollection('wissen')).filter((e) => cluster.wissen.includes(e.id))
  : [];

const items = [
  ...blogEntries.map((e) => ({
    href: `/blog/${e.id}`,
    label: 'Blog',
    title: e.data.title,
    description: e.data.description,
  })),
  ...wissenEntries.map((e) => ({
    href: `/wissen/${e.id}`,
    label: 'Wissen',
    title: e.data.title,
    description: e.data.description,
  })),
];
---

{items.length > 0 && (
  <section class="section bg-neutral-100">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <span class="section-label justify-center">Vertiefen</span>
        <h2>{title}</h2>
        {intro && (
          <p class="mt-4 text-lg text-neutral-600 leading-relaxed">{intro}</p>
        )}
      </div>

      <ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex h-full flex-col rounded-lg border border-neutral-200 bg-white p-6 no-underline transition-colors duration-200 hover:border-accent"
            >
              <span class="font-display text-xs font-semibold uppercase tracking-[0.08em] text-accent">
                {item.label}
              </span>
              <span class="mt-2 font-display text-lg font-semibold text-primary">
                {item.title}
              </span>
              <span class="mt-2 text-small text-neutral-600 leading-relaxed">
                {item.description}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
