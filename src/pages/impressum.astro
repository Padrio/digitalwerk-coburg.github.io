---
import PageLayout from '@layouts/PageLayout.astro';
import { buildSeoMeta } from '@utils/seo';
import { SITE } from '@data/site';

const seo = buildSeoMeta({
  title: 'Impressum',
  description: 'Impressum von Digitalwerk Coburg. Angaben gemäß § 5 DDG.',
  noIndex: true,
});
---

<PageLayout
  title={seo.title}
  description={seo.description}
  noIndex={seo.noIndex}
>
  <section class="section">
    <div class="container max-w-3xl">
      <h1>Impressum</h1>

      <h2 class="mt-10">Angaben gemäß § 5 DDG</h2>
      <p>
        {SITE.legal.companyName}<br />
        {SITE.legal.legalForm}<br />
        {SITE.address.street}<br />
        {SITE.address.zip} {SITE.address.city}<br />
        {SITE.address.countryName}
      </p>
      <p class="mt-4">
        Vertretungsberechtigte Gesellschafter: {SITE.legal.representatives.join(', ')}
      </p>

      <h2 class="mt-10">Kontakt</h2>
      <p>
        Telefon: {SITE.phone}<br />
        E-Mail: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>

      <h2 class="mt-10">Umsatzsteuer</h2>
      <p>
        {SITE.legal.vatNotice}
      </p>

      <h2 class="mt-10">Redaktionell verantwortlich (§ 18 Abs. 2 MStV)</h2>
      <p>
        {SITE.legal.contentResponsible}<br />
        {SITE.address.street}<br />
        {SITE.address.zip} {SITE.address.city}<br />
        {SITE.address.countryName}
      </p>

      <h2 class="mt-10">Verbraucherstreitbeilegung / Universalschlichtungsstelle</h2>
      <p>
        Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
        Verbraucherschlichtungsstelle teilzunehmen.
      </p>
    </div>
  </section>
</PageLayout>
