---
import PageLayout from '@layouts/PageLayout.astro';
import { buildSeoMeta } from '@utils/seo';
import { buildContactPage } from '@utils/schema';
import JsonLd from '@components/seo/JsonLd.astro';
import { SITE } from '@data/site';
import Hero from '@components/sections/Hero.astro';

import { Mail, Phone, MapPin, Clock, MessageCircle } from 'lucide-astro';
import NetworkPattern from '@components/decorative/NetworkPattern.astro';

// Gleiche Normalisierung wie in WhatsAppButton.astro
const whatsappNumber = SITE.phone.replace(/[\s()+-]/g, '').replace(/^0/, '49');
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  'Hallo Digitalwerk, ich interessiere mich für...'
)}`;

const seo = buildSeoMeta({
  title: 'Kontakt',
  description:
    'Nehmen Sie Kontakt mit Digitalwerk Coburg auf. Kostenloses Erstgespräch vereinbaren oder direkt eine Nachricht senden.',
});
---

<PageLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
>
  <JsonLd schema={buildContactPage()} />

  {/* 1. Hero */}
  <Hero
    variant="centered"
    badge="Kontakt"
    headline="Lassen Sie uns sprechen"
    subheadline="Ob Frage, Idee oder konkretes Projekt – ich freue mich auf Ihre Nachricht."
  />

  {/* Sentinel for CTASticky hide */}
  <div id="cta-sticky-sentinel"></div>

  {/* 2. Contact section: Form + Info */}
  <section class="section relative overflow-hidden">
    <NetworkPattern variant="dark" class="absolute -right-20 bottom-0 h-[400px] w-[400px] opacity-20" />
    <div class="container relative z-10">
      <div class="grid gap-12 lg:grid-cols-2">
        {/* Left: Direct contact channels */}
        <div>
          <h2 class="mb-2 font-display text-2xl font-bold text-primary">
            Schreiben Sie mir
          </h2>
          <p class="mb-8 text-neutral-600 leading-relaxed">
            Wählen Sie den Weg, der Ihnen am liebsten ist. Ich melde mich
            innerhalb von 24 Stunden bei Ihnen — kostenlos und unverbindlich.
          </p>

          <ul class="flex flex-col gap-4">
            <li>
              <a
                href={`mailto:${SITE.email}?subject=${encodeURIComponent('Anfrage über digitalwerk-coburg.de')}`}
                class="group flex items-start gap-4 rounded-[var(--radius-card)] border border-neutral-200 bg-white p-6 no-underline transition-colors duration-200 hover:border-accent"
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
                  <Mail class="h-6 w-6" />
                </span>
                <span class="block">
                  <span class="block font-display text-lg font-semibold text-primary">
                    E-Mail schreiben
                  </span>
                  <span class="mt-1 block text-small text-neutral-600 leading-relaxed">
                    Beschreiben Sie Ihr Vorhaben in Ruhe — ideal für konkrete
                    Projektanfragen.
                  </span>
                  <span class="mt-2 block font-display text-small font-medium text-accent">
                    {SITE.email}
                  </span>
                </span>
              </a>
            </li>

            <li>
              <a
                href={`tel:${SITE.phoneE164}`}
                class="group flex items-start gap-4 rounded-[var(--radius-card)] border border-neutral-200 bg-white p-6 no-underline transition-colors duration-200 hover:border-accent"
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
                  <Phone class="h-6 w-6" />
                </span>
                <span class="block">
                  <span class="block font-display text-lg font-semibold text-primary">
                    Anrufen
                  </span>
                  <span class="mt-1 block text-small text-neutral-600 leading-relaxed">
                    Montag bis Freitag, 9 bis 18 Uhr. Für schnelle Fragen der
                    kürzeste Weg.
                  </span>
                  <span class="mt-2 block font-display text-small font-medium text-accent">
                    {SITE.phone}
                  </span>
                </span>
              </a>
            </li>

            <li>
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start gap-4 rounded-[var(--radius-card)] border border-neutral-200 bg-white p-6 no-underline transition-colors duration-200 hover:border-accent"
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
                  <MessageCircle class="h-6 w-6" />
                </span>
                <span class="block">
                  <span class="block font-display text-lg font-semibold text-primary">
                    WhatsApp
                  </span>
                  <span class="mt-1 block text-small text-neutral-600 leading-relaxed">
                    Unkompliziert und direkt. Öffnet WhatsApp in einem neuen
                    Fenster.
                  </span>
                </span>
              </a>
            </li>
          </ul>
        </div>

        {/* Right: Contact info */}
        <div class="flex flex-col gap-6">
          <h2 class="font-display text-2xl font-bold text-primary">
            Kontaktdaten
          </h2>

          {/* Email card */}
          <div class="card flex items-start gap-4 p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <Mail class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-display text-sm font-semibold text-primary">E-Mail</h3>
              <a
                href={`mailto:${SITE.email}`}
                class="mt-1 block text-neutral-600 transition-colors hover:text-accent"
              >
                {SITE.email}
              </a>
            </div>
          </div>

          {/* Phone card */}
          <div class="card flex items-start gap-4 p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <Phone class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-display text-sm font-semibold text-primary">Telefon</h3>
              <a
                href={`tel:${SITE.phoneE164}`}
                class="mt-1 block text-neutral-600 transition-colors hover:text-accent"
              >
                {SITE.phone}
              </a>
            </div>
          </div>

          {/* Location card */}
          <div class="card flex items-start gap-4 p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <MapPin class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-display text-sm font-semibold text-primary">Standort</h3>
              <p class="mt-1 text-neutral-600">
                {SITE.address.street}<br />
                {SITE.address.zip} {SITE.address.city}<br />
                {SITE.address.region}
              </p>
            </div>
          </div>

          {/* 24h response badge */}
          <div class="flex items-center gap-3 rounded-[var(--radius-card)] border border-success/30 bg-success/10 p-5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-success/20 text-success">
              <Clock class="h-5 w-5" />
            </div>
            <div>
              <p class="font-display text-sm font-semibold text-success">
                Antwort innerhalb von 24 Stunden
              </p>
              <p class="mt-0.5 text-small text-neutral-600">
                In der Regel melde ich mich sogar schneller.
              </p>
            </div>
          </div>

          {/* About me teaser */}
          <div class="card p-6">
            <h3 class="font-display text-sm font-semibold text-primary">
              Ihr Ansprechpartner
            </h3>
            <p class="mt-2 text-small text-neutral-600 leading-relaxed">
              Bei Digitalwerk arbeite ich allein. Sie sprechen direkt mit mir,
              kein Account-Management dazwischen.{' '}
              <a href="/ueber-mich" class="text-accent font-medium hover:underline">
                Mehr über mich erfahren &rarr;
              </a>
            </p>
          </div>

        </div>
      </div>
    </div>
  </section>
</PageLayout>
